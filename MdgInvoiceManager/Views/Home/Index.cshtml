@model IEnumerable<MdgInvoiceManager.Models.Invoice>

@{
    ViewData["Title"] = "Müşteri Fatura Paneli";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Müşteri Fatura Listesi</h2>

    <div class="text-end mb-3">
        <a asp-action="Create" class="btn btn-primary">+ Yeni Fatura Ekle</a>
    </div>

    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Fatura ID</th>
                <th>Müşteri Adı</th>
                <th>Fatura Tutarı</th>
                <th>Fatura Belgesi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var fatura in Model)
                {
                    <tr>
                        <td class="text-center">@fatura.Id</td>
                        <td>@fatura.CustomerName</td>
                        <td>@fatura.Amount.ToString("C2")</td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(fatura.FilePath))
                            {
                                <a href="@fatura.FilePath" target="_blank" class="btn btn-sm btn-outline-danger">
                                    📄 PDF / Belgeyi Aç
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Belge Yok</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Veritabanında henüz hiç fatura bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>