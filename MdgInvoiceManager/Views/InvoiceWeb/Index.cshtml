@model IEnumerable<MdgInvoiceManager.Models.Invoice>

@{
    ViewData["Title"] = "Fatura Listesi";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🧾 e-Fatura Yönetim Paneli</h2>
        <a href="/InvoiceWeb/Create" class="btn btn-success">➕ Yeni Fatura Oluştur</a>
    </div>

    <table class="table table-striped table-hover shadow-sm rounded">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Müşteri / Firma</th>
                <th>VKN/TCKN</th>
                <th>Şehir</th>
                <th>Matrah (₺)</th>
                <th>KDV (%20)</th>
                <th>Toplam (₺)</th>
                <th>Fatura Tipi</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>#@item.Id</strong></td>
                        <td>@item.CustomerName</td>
                        <td>@item.VknTckn</td>
                        <td>@item.City</td>
                        <td>@item.Amount.ToString("N2") ₺</td>
                        <td class="text-danger">@item.TaxAmount.ToString("N2") ₺</td>
                        <td class="text-success fw-bold">@item.TotalAmount.ToString("N2") ₺</td>
                        <td><span class="badge bg-primary">@item.InvoiceType</span></td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">Henüz kayıtlı bir fatura bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
</div>